{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "production": {
      "node": "20.19.4",
      "autoIncrement": true,
      "distribution": "store",
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease"
      }
    },
    "preview": {
      "node": "20.19.4",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-api-key.json",
        "track": "production",
        "changesNotSentForReview": false
      }
    }
  }
}