{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "production": {
      "node": "18.18.0",
      "npm": "9.6.7",
      "autoIncrement": true,
      "distribution": "store",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:bundleRelease"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-api-key.json",
        "track": "production",
        "changesNotSentForReview": false
      },
      "ios": {
        "appleId": "",
        "ascAppId": "",
        "appleTeamId": ""
      }
    }
  }
}