{
  "expo": {
    "name": "VauLt",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vault",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.securevaultsync.gbpwid"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.securevaultsync.gbpwid"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Unlock your VauLt vault"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock your VauLt vault"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos to your encrypted vault entries",
          "cameraPermission": "Capture photos and videos for your encrypted vault entries",
          "microphonePermission": "Record videos with sound for your encrypted vault entries"
        }
      ],
      "./plugins/withVauLtExtensions.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}