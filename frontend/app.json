{
  "expo": {
    "name": "VauLt",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "vault",
      "com.emergent.securevaultsync.gbpwid"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.securevaultsync.gbpwid"
    },
    "android": {
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.securevaultsync.gbpwid",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE"
      ],
      "googlePlayServicesVersion": "22.6.0",
      "intentFilters": [
        {
          "action": "android.intent.action.VIEW",
          "data": {
            "scheme": "https",
            "host": "*.vault",
            "pathPrefix": "/"
          },
          "category": [
            "android.intent.category.BROWSABLE",
            "android.intent.category.DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Unlock your VauLt vault"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock your VauLt vault"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos to your encrypted vault entries",
          "cameraPermission": "Capture photos and videos for your encrypted vault entries",
          "microphonePermission": "Record videos with sound for your encrypted vault entries"
        }
      ],
      "./plugins/withVauLtExtensions.js",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.emergent.securevaultsync.gbpwid.** { *; }\n-keep class com.facebook.hermes.** { *; }\n-keep class com.facebook.jni.** { *; }\n-dontwarn com.emergent.securevaultsync.gbpwid.**"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bd1b44d1-1f29-42f2-b123-e1a304ba1a46"
      }
    },
    "owner": "vinz54"
  }
}
